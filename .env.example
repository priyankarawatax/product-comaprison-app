# MySQL 8 database (create it before npm run setup). URL-encode special password characters.
DATABASE_URL="mysql://app_user:password@127.0.0.1:3306/ai_visualization"

# Shopify CLI supplies these during app dev; set them on your production host.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL="https://bogoboosterstaging.axtrics.com"

# Partner API token: Partner Dashboard > Settings > Partner API clients > Manage apps.
# This is an organization token, NOT a shop access token or the app secret.
SHOPIFY_PARTNER_ORGANIZATION_ID=""
SHOPIFY_PARTNER_ACCESS_TOKEN=""
# Numeric Partner app GID, NOT the hexadecimal SHOPIFY_API_KEY.
SHOPIFY_PARTNER_APP_ID="gid://shopify/App/REPLACE_WITH_NUMERIC_ID"
# The official Shopify documentation aliases are also supported:
# SHOPIFY_PARTNER_ORG_ID=""
# SHOPIFY_PARTNER_API_ACCESS_TOKEN=""
# SHOPIFY_APP_GID="gid://shopify/App/REPLACE_WITH_NUMERIC_ID"
# App listing handle used in the hosted pricing page URL.
SHOPIFY_APP_HANDLE=""

# Exact activeSubscription.items[].handle values configured for your recurring plans.
# Use the same recurring item handle for a plan's monthly and annual options.
SHOPIFY_FREE_ITEM_HANDLE="free"
SHOPIFY_GROWTH_ITEM_HANDLE="starter"
SHOPIFY_PRO_ITEM_HANDLE="growth"

# Product Compare: exact Liquid filenames, without .liquid, in the deployed theme extension.
SHOPIFY_COMPARE_EMBED_HANDLE="app-embed"
SHOPIFY_COMPARE_BLOCK_HANDLE="comparison-block"
