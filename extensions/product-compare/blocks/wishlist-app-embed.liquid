{% assign wishlist_page = pages[block.settings.wishlist_page] %}
{% assign wishlist_page_url = wishlist_page.url | default: pages['wishlist'].url %}
{% if wishlist_page_url == blank %}{% assign wishlist_page_url = routes.root_url | append: 'pages/wishlist' %}{% endif %}
<div class="pickwise-wishlist-root" data-pickwise-wishlist data-settings-url="{{ routes.root_url }}apps/product-comparison/wishlist/settings" data-session-url="{{ routes.root_url }}apps/product-comparison/wishlist/session" data-items-url="{{ routes.root_url }}apps/product-comparison/wishlist/items" data-add-url="{{ routes.root_url }}apps/product-comparison/wishlist/add" data-remove-url="{{ routes.root_url }}apps/product-comparison/wishlist/remove" data-merge-url="{{ routes.root_url }}apps/product-comparison/wishlist/merge" data-shop="{{ shop.permanent_domain | escape }}" data-customer="{% if customer %}1{% else %}0{% endif %}" data-page-url="{{ wishlist_page_url | escape }}" data-shop-root="{{ routes.root_url | escape }}" {{ block.shopify_attributes }}></div>
{% if request.path == wishlist_page_url %}<div class="pickwise-wishlist-page" data-pickwise-wishlist-page><div class="pickwise-wishlist-page-mount"></div></div>{% endif %}
<script defer src="{{ 'pickwise-wishlist.js' | asset_url }}"></script>
<script defer src="{{ 'pickwise-wishlist-ui.js' | asset_url }}"></script>
<script defer src="{{ 'pickwise-wishlist-header.js' | asset_url }}"></script>
<script defer src="{{ 'pickwise-wishlist-page.js' | asset_url }}"></script>
{% schema %}
{"name":"Pickwise Wishlist","target":"body","stylesheet":"pickwise-wishlist.css","settings":[{"type":"page","id":"wishlist_page","label":"Wishlist page"}]}
{% endschema %}
